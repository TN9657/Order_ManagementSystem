# Database
# Use SQLite for local development by default so the app runs without a separate PostgreSQL server.
# For PostgreSQL, override it with a full DATABASE_URL like:
# DATABASE_URL=postgresql://user:password@localhost:5432/order_management
DATABASE_URL=sqlite:///./order_management.db

# App
DEBUG=False
ENVIRONMENT=development

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
